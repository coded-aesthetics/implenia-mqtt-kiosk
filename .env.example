# ==================================================
# Implenia Kiosk — Environment Configuration
# ==================================================
# Copy this file to .env and fill in the values.
# All variables without defaults are REQUIRED.
# ==================================================

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtt://192.168.1.50:1883
MQTT_TOPICS="sensors/#"

# --- Implenia REST API (optional — configurable in UI) ---
# IMPLENIA_API_URL=https://api.imp-ice-messtechnik.de
# IMPLENIA_API_KEY=your-base64-encoded-token

# --- Self-Updater (GitHub Releases) ---
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
# Optional: token for private repos
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Check interval in ms (default: ~1 hour)
# UPDATE_CHECK_INTERVAL_MS=3500000

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Connectivity Probe ---
# DNS host used to check internet reachability
# CONNECTIVITY_PROBE_HOST=8.8.8.8
# Poll interval in ms (default: 30 seconds)
# CONNECTIVITY_POLL_INTERVAL_MS=30000

# --- USB Update ---
# Comma-separated directories to scan for update bundles
# USB_UPDATE_PATHS=/media

# --- Log Sensor Upload ---
# Upload warn/error logs as string sensor readings to the portal
# LOG_SENSOR_UPLOAD=false
# Minimum level for uploaded log entries (debug|info|warn|error|fatal)
# LOG_SENSOR_LEVEL=warn
