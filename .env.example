# ==================================================
# Implenia Kiosk — Environment Configuration
# ==================================================
# Copy this file to .env and fill in the values.
# All variables without defaults are REQUIRED.
# ==================================================

# --- MQTT Broker (optional) ---
# Normally set by the setup wizard and stored in the database, not here. A
# stored value always wins over these. They act as a pre-seed for a prepared
# release image; leave them blank on a machine that will be set up on site.
# The wizard defaults to mqtt://192.168.2.1:1883 — the Implenia MQTT box — and
# to the wide "#" filter, so unknown topic names stay visible during setup.
MQTT_BROKER_URL=mqtt://192.168.2.1:1883
MQTT_TOPICS="#"

# --- Implenia REST API (optional — configurable in UI) ---
# IMPLENIA_API_URL=https://api.imp-ice-messtechnik.de
# IMPLENIA_API_KEY=your-base64-encoded-token

# --- Self-Updater (GitHub Releases) (optional) ---
# These describe the software distribution, not the machine, so they belong in
# the release image and are never typed on site. Without them GitHub polling is
# skipped; USB updates keep working.
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
# Optional: token for private repos
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Check interval in ms (default: ~1 hour)
# UPDATE_CHECK_INTERVAL_MS=3500000

# --- Database (optional) ---
# Defaults to <cwd>/kiosk.db. ':memory:' gives an ephemeral database, which is
# how the integration tests exercise real SQL without touching a real kiosk DB.
# DB_PATH=/var/lib/implenia-kiosk/kiosk.db

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Connectivity Probe ---
# DNS host used to check internet reachability
# CONNECTIVITY_PROBE_HOST=8.8.8.8
# Poll interval in ms (default: 30 seconds)
# CONNECTIVITY_POLL_INTERVAL_MS=30000

# --- USB Update ---
# Comma-separated directories to scan for update bundles
# USB_UPDATE_PATHS=/media

# --- Replay Server (dev-only) ---
# Standalone replay server for playing back captured MQTT dumps.
# REPLAY_MQTT_PORT=1884
# REPLAY_PORT=3001

# --- Log Sensor Upload ---
# Upload warn/error logs as string sensor readings to the portal
# LOG_SENSOR_UPLOAD=false
# Minimum level for uploaded log entries (debug|info|warn|error|fatal)
# LOG_SENSOR_LEVEL=warn
